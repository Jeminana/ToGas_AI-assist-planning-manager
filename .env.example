# Development is offline by default. Mock suggestions are NOT Jev predictions.
TOGAS_AI_MODE=mock
# Paste the classroom API key only into your private .env, never this template.
JEV_API_KEY=
JEV_MODEL=jev-latest
# Optional, explicitly configured local OpenJevX (not needed for normal development):
# TOGAS_AI_MODE=local
# TOGAS_OPENJEVX_DIR=C:/path/to/reviewed/openjevx-files
# TOGAS_AI_MODE=jev opts into the official TypeSafe API. Leave mock for daily work.
